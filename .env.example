LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional: model riêng cho bước planner/skill-select (JSON). Rỗng -> dùng LLM_MODEL.
# Dùng model nhanh hơn ở đây để giảm latency, vd: Qwen 3.5 27b / gemma 4 31b-it.
LLM_PLANNER_MODEL=
# Optional: timeout (giây) cho mỗi lần gọi LLM. Mặc định 30.
LLM_TIMEOUT=30
DATABASE_URL=
# Optional: số connection tối đa trong pool tới Postgres. Mặc định 10.
DB_POOL_MAX_SIZE=10
CHAT_CONTEXT_BACKEND=auto
CHAT_CONTEXT_MEMORY_ID=
CHAT_CONTEXT_EVENT_LIMIT=12
CHAT_CONTEXT_FALLBACK_ON_MEMORY_ERROR=true
# Optional: cache reference data trong RAM (knowledge_base/data_dictionary/question_examples).
# Mặc định true. Đặt false để luôn đọc thẳng từ DB.
REFERENCE_CACHE_ENABLED=true
# Optional: bỏ qua lần gọi LLM synthesis khi planner đã trả answer dùng được. Mặc định true.
CHAT_SKIP_SYNTHESIS_ON_PLANNER_ANSWER=true
